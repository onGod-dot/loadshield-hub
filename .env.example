# ── Server-side secrets (never sent to the browser) ──────────────────────────
# Groq API key — used by the LoadShield gateway to proxy AI chat requests.
# Get your free key at: https://console.groq.com/keys
# Set this on your server/hosting platform, NOT in any file you commit.
GROQ_API_KEY=your_groq_api_key_here

# ── Frontend config ───────────────────────────────────────────────────────────
# Gateway URL — the React app uses this to connect to LoadShield.
# In production, change this to your deployed gateway URL.
LOADSHIELD_BASE_URL=http://localhost:4000
